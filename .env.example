NODE_ENV=development
API_PORT=4000
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/trelloclone
REDIS_URL=redis://localhost:6379
JWT_ACCESS_SECRET=change_me_access
JWT_REFRESH_SECRET=change_me_refresh
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=30d
WEB_ORIGIN=http://localhost:3000
COOKIE_DOMAIN=localhost
SPACES_ENDPOINT=https://nyc3.digitaloceanspaces.com
SPACES_REGION=nyc3
SPACES_BUCKET=trello-clone-uploads
SPACES_KEY=
SPACES_SECRET=
SPACES_PUBLIC_BASE_URL=https://trello-clone-uploads.nyc3.cdn.digitaloceanspaces.com
UPLOAD_MAX_BYTES=26214400
NEXT_PUBLIC_API_URL=http://localhost:4000
NEXT_PUBLIC_WS_URL=http://localhost:4000

# SubZero incident reporting. Any request that fails with a 500 files an
# incident. Leave these empty locally and nothing is reported; on
# demo.sub-zero.dev each prospect's crashes go to their own sandbox instead.
SUBZERO_URL=https://api.sub-zero.dev/incidents/external
SUBZERO_PROJECT_KEY=
SUBZERO_INGEST_KEY=

# demo.sub-zero.dev only. Off unless DEMO_MODE=true.
DEMO_MODE=false
NEXT_PUBLIC_DEMO_MODE=false
SUBZERO_DEMO_PROVISION_URL=https://api.sub-zero.dev/demo/provision
DEMO_PROVISION_SECRET=
DEMO_REPO_URL=https://github.com/Ascendant-Finance/subzero-demo
SUBZERO_DASHBOARD_URL=https://dashboard.sub-zero.dev
SUBZERO_PUBLIC_API_URL=https://api.sub-zero.dev
DEMO_SIGNUPS_PER_IP_PER_HOUR=5
DEMO_SIGNUPS_PER_DAY=200
# Optional Slack/Discord webhook told about each new signup.
DEMO_LEAD_WEBHOOK_URL=
# Koryo inbound capture (server only, never NEXT_PUBLIC_). Unset: no lead is sent.
KORYO_CAPTURE_KEY=
KORYO_CAPTURE_URL=https://api.koryo.app/capture
